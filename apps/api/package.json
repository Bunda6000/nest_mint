{
  "name": "@nestmint/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestmint/finance-engine": "workspace:^",
    "@nestmint/shared": "workspace:^",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "exceljs": "4.4.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.0",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  },
  "type": "module"
}
