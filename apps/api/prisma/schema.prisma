// Database schema. See Notion: 04 · Application Design.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  displayName        String?   @map("display_name")
  baseCurrency       String    @default("MKD") @map("base_currency") @db.Char(3)
  displayCurrency    String    @default("EUR") @map("display_currency") @db.Char(3)
  locale             String    @default("en")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  /// Set once when the default categories were created; never seeded again after that.
  categoriesSeededAt DateTime? @map("categories_seeded_at")

  refreshTokens  RefreshToken[]
  categoryGroups CategoryGroup[]
  categories     Category[]
  transactions   Transaction[]
  incomes        Income[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// rotated | logout | reuse
  revokeReason String?   @map("revoke_reason")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model CategoryGroup {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  sortOrder  Int       @map("sort_order")
  /// Archived groups are hidden but kept, so history can still show them.
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories Category[]

  @@unique([userId, name])
  /// Lets categories reference (group, owner) together, so a category can never point at another user's group.
  @@unique([id, userId])
  @@map("category_groups")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  groupId    String    @map("group_id") @db.Uuid
  name       String
  sortOrder  Int       @map("sort_order")
  /// Archived categories are hidden but kept, so history can still show them.
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group CategoryGroup @relation(fields: [groupId, userId], references: [id, userId], onDelete: Cascade)

  transactions Transaction[]

  @@unique([groupId, name])
  /// Lets transactions reference (category, owner) together, so a transaction can never use another user's category.
  @@unique([id, userId])
  @@index([userId])
  @@map("categories")
}

/// A cash withdrawal leaves the bank account and counts as an expense, but is tagged so it can be told apart.
enum TransactionKind {
  expense
  cash_withdrawal

  @@map("transaction_kind")
}

/// Money that moved. For now only expenses; amounts are whole denars (see docs/adr/008-money-and-exchange-rates.md).
model Transaction {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  categoryId String          @map("category_id") @db.Uuid
  kind       TransactionKind @default(expense)
  /// Whole denars, always above 0 (checked in the database as well).
  amountMkd  Int             @map("amount_mkd")
  /// The calendar day the money was spent, no time of day.
  occurredOn DateTime        @map("occurred_on") @db.Date
  note       String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NoAction: a category in use cannot be deleted; deleting the whole user still works because both cascade.
  category Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction)

  @@index([userId, occurredOn(sort: Desc)])
  @@map("transactions")
}

/// A salary repeats every month (stored once); other income happens once (stored with its date).
enum IncomeRecurrence {
  monthly
  one_off

  @@map("income_recurrence")
}

/// Money coming in. Amounts are whole denars. Monthly: startMonth, optional endMonth (both the first
/// day of their month) and payDay; one-off: receivedOn. The database checks that the right ones are set.
model Income {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  name       String
  amountMkd  Int              @map("amount_mkd")
  recurrence IncomeRecurrence
  receivedOn DateTime?        @map("received_on") @db.Date
  startMonth DateTime?        @map("start_month") @db.Date
  endMonth   DateTime?        @map("end_month") @db.Date
  payDay     Int?             @map("pay_day") @db.SmallInt
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("incomes")
}
