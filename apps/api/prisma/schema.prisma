// Database schema. See Notion: 04 · Application Design.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  displayName        String?   @map("display_name")
  baseCurrency       String    @default("MKD") @map("base_currency") @db.Char(3)
  displayCurrency    String    @default("EUR") @map("display_currency") @db.Char(3)
  locale             String    @default("en")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  /// Set once when the default categories were created; never seeded again after that.
  categoriesSeededAt DateTime? @map("categories_seeded_at")

  refreshTokens  RefreshToken[]
  categoryGroups CategoryGroup[]
  categories     Category[]
  transactions   Transaction[]
  incomes        Income[]
  obligations    Obligation[]
  bills          Bill[]
  loanRateChanges LoanRateChange[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// rotated | logout | reuse
  revokeReason String?   @map("revoke_reason")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model CategoryGroup {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  sortOrder  Int       @map("sort_order")
  /// Archived groups are hidden but kept, so history can still show them.
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories Category[]

  @@unique([userId, name])
  /// Lets categories reference (group, owner) together, so a category can never point at another user's group.
  @@unique([id, userId])
  @@map("category_groups")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  groupId    String    @map("group_id") @db.Uuid
  name       String
  sortOrder  Int       @map("sort_order")
  /// Archived categories are hidden but kept, so history can still show them.
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group CategoryGroup @relation(fields: [groupId, userId], references: [id, userId], onDelete: Cascade)

  transactions Transaction[]
  obligations  Obligation[]

  @@unique([groupId, name])
  /// Lets transactions reference (category, owner) together, so a transaction can never use another user's category.
  @@unique([id, userId])
  @@index([userId])
  @@map("categories")
}

/// A cash withdrawal leaves the bank account and counts as an expense, but is tagged so it can be told apart.
enum TransactionKind {
  expense
  cash_withdrawal

  @@map("transaction_kind")
}

/// Money that moved. For now only expenses; amounts are whole denars (see docs/adr/008-money-and-exchange-rates.md).
model Transaction {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  categoryId String          @map("category_id") @db.Uuid
  kind       TransactionKind @default(expense)
  /// Whole denars, always above 0 (checked in the database as well).
  amountMkd  Int             @map("amount_mkd")
  /// The calendar day the money was spent, no time of day.
  occurredOn DateTime        @map("occurred_on") @db.Date
  note       String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NoAction: a category in use cannot be deleted; deleting the whole user still works because both cascade.
  category Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction)
  /// The bill this expense paid, if any. Such an expense cannot be deleted until the payment is undone.
  bill     Bill?

  /// Lets a bill reference (expense, owner) together, so a bill can never point at another user's expense.
  @@unique([id, userId])
  @@index([userId, occurredOn(sort: Desc)])
  @@map("transactions")
}

/// A salary repeats every month (stored once); other income happens once (stored with its date).
enum IncomeRecurrence {
  monthly
  one_off

  @@map("income_recurrence")
}

/// Money coming in. Amounts are whole denars. Monthly: startMonth, optional endMonth (both the first
/// day of their month) and payDay; one-off: receivedOn. The database checks that the right ones are set.
model Income {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  name       String
  amountMkd  Int              @map("amount_mkd")
  recurrence IncomeRecurrence
  receivedOn DateTime?        @map("received_on") @db.Date
  startMonth DateTime?        @map("start_month") @db.Date
  endMonth   DateTime?        @map("end_month") @db.Date
  payDay     Int?             @map("pay_day") @db.SmallInt
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("incomes")
}

/// How often a recurring bill is due: every month, every n months from its start month, or only in
/// chosen calendar months (such as the heating season).
enum ObligationRecurrence {
  monthly
  every_n_months
  custom_months

  @@map("obligation_recurrence")
}

/// What an obligation is: a plain recurring bill, or a loan paid back in monthly instalments.
enum ObligationKind {
  bill
  loan

  @@map("obligation_kind")
}

/// What a loan was taken for. Only set on loans.
enum LoanType {
  housing
  consumer
  other

  @@map("loan_type")
}

/// A recurring bill, stored once with its schedule. Amounts are whole denars. Months are the first
/// day of their month. `everyNMonths` applies to every_n_months and `months` (1 = January) to
/// custom_months; the database checks that the right ones are set. A loan is an obligation of kind
/// `loan`: it is paid monthly (expectedAmountMkd is the monthly payment), the lender is the payee,
/// and it has a principal, a yearly rate in basis points (450 = 4.50 %) and a last month.
model Obligation {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  categoryId        String               @map("category_id") @db.Uuid
  name              String
  payee             String?
  expectedAmountMkd Int                  @map("expected_amount_mkd")
  dueDay            Int                  @map("due_day") @db.SmallInt
  recurrence        ObligationRecurrence
  everyNMonths      Int?                 @map("every_n_months") @db.SmallInt
  months            Int[]                @default([]) @db.SmallInt
  startMonth        DateTime             @map("start_month") @db.Date
  endMonth          DateTime?            @map("end_month") @db.Date
  kind              ObligationKind       @default(bill)
  loanType          LoanType?            @map("loan_type")
  principalMkd      Int?                 @map("principal_mkd")
  annualRateBp      Int?                 @map("annual_rate_bp")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NoAction: a category in use cannot be deleted; deleting the whole user still works because both cascade.
  category Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction)
  bills    Bill[]
  rateChanges LoanRateChange[]

  /// Lets bills reference (obligation, owner) together, so a bill can never point at another user's obligation.
  @@unique([id, userId])
  @@index([userId])
  @@map("obligations")
}

/// New terms of a loan from one month on: the rate and the monthly payment the bank asks for. The
/// loan's own rate and payment are the terms of its first month. At most one change per loan and
/// month; a second one for the same month replaces the first.
model LoanRateChange {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  obligationId     String   @map("obligation_id") @db.Uuid
  /// The first month the new terms apply: the first day of that month.
  effectiveMonth   DateTime @map("effective_month") @db.Date
  annualRateBp     Int      @map("annual_rate_bp")
  monthlyPaymentMkd Int     @map("monthly_payment_mkd")
  createdAt        DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cascade: the changes are details of the loan and go with it (deleting an obligation, NM-18).
  obligation Obligation @relation(fields: [obligationId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([obligationId, effectiveMonth])
  @@index([userId])
  @@map("loan_rate_changes")
}

/// One bill: an obligation's expected amount due in one month. Created from the obligation, at most
/// one per obligation and month (the unique key below is what stops duplicates).
model Bill {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  obligationId      String   @map("obligation_id") @db.Uuid
  /// The month the bill belongs to: the first day of that month.
  periodMonth       DateTime @map("period_month") @db.Date
  dueDate           DateTime @map("due_date") @db.Date
  /// What the obligation expected when this bill was created.
  expectedAmountMkd Int      @map("expected_amount_mkd")
  /// The real amount from the invoice, once known; replaces the expected amount until the bill is paid.
  actualAmountMkd   Int?     @map("actual_amount_mkd")
  invoiceRef        String?  @map("invoice_ref")
  /// The expense that records the payment. A bill is paid exactly when this is set; the paid day
  /// and amount are the expense's own, so there is one place to correct them.
  transactionId     String?  @map("transaction_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NoAction: an obligation with bills cannot be deleted; deleting the whole user still works because both cascade.
  obligation  Obligation   @relation(fields: [obligationId, userId], references: [id, userId], onDelete: NoAction)
  /// NoAction: the expense of a paid bill cannot be deleted; the payment is undone first.
  transaction Transaction? @relation(fields: [transactionId, userId], references: [id, userId], onDelete: NoAction)

  @@unique([obligationId, periodMonth])
  @@unique([transactionId, userId])
  @@index([userId, periodMonth])
  @@map("bills")
}
