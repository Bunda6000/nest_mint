{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx --yes pnpm@9.15.9 install --no-frozen-lockfile",
  "buildCommand": "npx --yes pnpm@9.15.9 --filter @nestmint/web... build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
